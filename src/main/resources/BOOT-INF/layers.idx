  - "BOOT-INF/classes/application-*.yml"
  - "BOOT-INF/classes/config/"
- "application":
  - "BOOT-INF/classes/"
  - "BOOT-INF/classpath.idx"
  - "BOOT-INF/layers.idx"
  - "META-INF/"
